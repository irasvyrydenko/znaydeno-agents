# Copy to .env (gitignored) and fill in. Never commit real keys.

# Local LLM via Ollama (no API key needed)
OLLAMA_HOST=http://localhost:11434
# Same model must be used for the Matcher, Verifier and single-agent baseline
LOSTFOUND_MODEL=qwen3:8b

# Tracing: configure only the backend you chose
# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=znaideno-agents
